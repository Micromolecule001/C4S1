          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell value="payment ok" style="endArrow=block;" edge="1" parent="1" source="pay" target="web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell value="confirm" style="endArrow=block;" edge="1" parent="1" source="web" target="cust">
